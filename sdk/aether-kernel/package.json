{
  "name": "@aether/kernel",
  "version": "1.0.0",
  "description": "Foundational SDK for the Aether Application Ecosystem. Provides unified protocol buffers, NATS-based event bus, identity management, and abstract AI vendor interfaces.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "protos"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run build:protos",
    "build:protos": "pbjs -t static-module -w commonjs -o dist/protos/schema.js protos/*.proto && pbts -o dist/protos/schema.d.ts dist/protos/schema.js",
    "clean": "rimraf dist",
    "test": "jest --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aether-ecosystem/kernel.git"
  },
  "keywords": [
    "aether",
    "ai",
    "sdk",
    "nats",
    "protobuf",
    "microservices",
    "orchestration"
  ],
  "author": "Aether Systems Integration <core@aether.network>",
  "license": "Proprietary",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.454.0",
    "@azure/identity": "^4.0.0",
    "@google-cloud/local-auth": "^3.0.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/exporter-prometheus": "^0.45.1",
    "@opentelemetry/sdk-node": "^0.45.1",
    "axios": "^1.6.2",
    "axios-retry": "^3.9.1",
    "dotenv": "^16.3.1",
    "fp-ts": "^2.16.1",
    "ioredis": "^5.3.2",
    "jose": "^5.1.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "nats": "^2.19.0",
    "pino": "^8.16.2",
    "protobufjs": "^7.2.5",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}