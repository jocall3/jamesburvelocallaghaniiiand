# Core API Settings
# The port on which the API server will listen.
PORT=8080

# The logging level for the application (e.g., debug, info, warn, error).
LOG_LEVEL=info

# --- AWS Billing Configuration ---
# AWS Access Key ID with permissions to access billing data (e.g., S3 bucket for CUR).
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID

# AWS Secret Access Key corresponding to the Access Key ID.
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# The AWS region where your billing bucket or related resources are located.
AWS_REGION=us-east-1

# The name of the S3 bucket where AWS Cost and Usage Reports (CUR) are stored.
AWS_BILLING_BUCKET_NAME=your-aws-cur-bucket-name

# The path within the S3 bucket to the CUR files (e.g., 'your-report-name/').
AWS_BILLING_REPORT_PATH=your-report-name/

# --- GCP Billing Configuration ---
# Your Google Cloud Project ID where billing data is exported to BigQuery.
GCP_PROJECT_ID=your-gcp-project-id

# Path to the Google Cloud service account key file (JSON format) with BigQuery Viewer role
# and permissions to access billing export data.
GCP_SERVICE_ACCOUNT_KEY_PATH=/path/to/your/gcp-service-account-key.json

# The BigQuery dataset ID where your GCP billing export data resides.
GCP_BILLING_DATASET_ID=your_billing_dataset_id

# The BigQuery table ID for your GCP billing export (e.g., gcp_billing_export_v1_XXXXXX).
GCP_BILLING_TABLE_ID=gcp_billing_export_v1_XXXXXXXX

# --- Azure Billing Configuration ---
# Your Azure Active Directory (AAD) Tenant ID.
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID

# Your Azure Application (Client) ID with permissions to access Cost Management APIs.
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID

# Your Azure Application (Client) Secret.
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET

# Your Azure Subscription ID for which you want to retrieve billing data.
AZURE_SUBSCRIPTION_ID=YOUR_AZURE_SUBSCRIPTION_ID

# The name of the Azure Billing Account or Enrollment Account (if applicable)
# for accessing cost management data.
AZURE_BILLING_ACCOUNT_NAME=your-azure-billing-account-name

# --- Optional Database Configuration (for internal state/metadata) ---
# Uncomment and configure if the API needs a database to store its own operational data
# or normalized billing data. Example for PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database_name