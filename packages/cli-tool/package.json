{
  "name": "@example/cli-tool",
  "version": "0.1.0",
  "description": "A command-line interface for managing the ecosystem.",
  "main": "dist/index.js",
  "bin": {
    "ecosystem": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run test",
    "postpublish": "npm publish",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "keywords": [
    "cli",
    "ecosystem",
    "management"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^9.4.1",
    "dotenv": "^16.3.1",
    "ora": "^5.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^18.19.3",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.5"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}