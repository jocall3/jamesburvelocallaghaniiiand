{
  "name": "@ocip/core-sdk",
  "version": "1.0.0",
  "description": "Core SDK for the Orchestrated Cognitive Infrastructure Platform, providing shared utilities for logging, configuration, event bus, authentication, and data contracts.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/types/contracts/index.d.ts",
        "default": "./dist/esm/contracts/index.js"
      },
      "require": {
        "types": "./dist/types/contracts/index.d.ts",
        "default": "./dist/cjs/contracts/index.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/types/config/index.d.ts",
        "default": "./dist/esm/config/index.js"
      },
      "require": {
        "types": "./dist/types/config/index.d.ts",
        "default": "./dist/cjs/config/index.js"
      }
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocip/platform.git",
    "directory": "packages/ocip-core-sdk"
  },
  "keywords": [
    "ai",
    "sdk",
    "orchestration",
    "ocip",
    "core",
    "platform",
    "api",
    "integration",
    "event-bus",
    "logging",
    "config"
  ],
  "author": "OCIP Engineering <contact@ocip.dev>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ocip/platform/issues"
  },
  "homepage": "https://github.com/ocip/platform/tree/main/packages/ocip-core-sdk#readme",
  "dependencies": {
    "axios": "^1.7.2",
    "convict": "^6.2.4",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.26.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "uuid": "^14.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}