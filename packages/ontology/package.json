{
  "name": "@ecosystem/ontology",
  "version": "1.0.0",
  "private": true,
  "description": "Shared data contracts, schemas, and type definitions for the AI application ecosystem. Based on Protobuf for type-safe, cross-service communication.",
  "keywords": [
    "ontology",
    "schema",
    "protocol",
    "types",
    "protobuf",
    "ecosystem",
    "contracts"
  ],
  "license": "Apache-2.0",
  "author": "Ecosystem Architect AI <architect@ecosystem.ai>",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "proto"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./proto/*": "./proto/*"
  },
  "scripts": {
    "clean": "rm -rf dist src/gen",
    "lint": "npm run lint:proto && npm run lint:ts",
    "lint:proto": "buf lint",
    "lint:ts": "eslint . --ext .ts --report-unused-disable-directives --max-warnings 0",
    "generate": "buf generate",
    "build": "npm run clean && npm run generate && tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.32.0",
    "@bufbuild/protoc-gen-es": "^1.8.0",
    "@bufbuild/protoc-gen-zod": "^0.5.1",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}