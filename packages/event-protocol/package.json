{
  "name": "@aetheris/event-protocol",
  "version": "0.1.0",
  "description": "Shared event protocol definitions (Protobuf) and client for the Aetheris application ecosystem.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "clean": "rimraf dist gen",
    "generate:proto": "rimraf src/gen && mkdir -p src/gen && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/gen --ts_proto_opt=esModuleInterop=true,outputServices=generic-definitions,useExactTypes=false,forceLong=string,oneof=unions --proto_path=./schemas $(find ./schemas -name \"*.proto\")",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run generate:proto && npm run build",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aetheris-ai/ecosystem.git"
  },
  "keywords": [
    "aetheris",
    "protocol",
    "events",
    "protobuf",
    "nats",
    "ai",
    "ecosystem"
  ],
  "author": "Aetheris AI, Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/aetheris-ai/ecosystem/issues"
  },
  "homepage": "https://github.com/aetheris-ai/ecosystem/tree/main/packages/event-protocol#readme",
  "dependencies": {
    "long": "^5.2.3",
    "nats": "^2.20.0",
    "pino": "^8.19.0",
    "protobufjs": "^7.2.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "grpc-tools": "^1.12.4",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-proto": "^1.171.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}