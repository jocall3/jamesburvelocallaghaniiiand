{
  "name": "@aetheris/ui-components",
  "version": "0.1.0",
  "private": false,
  "description": "Shared library of React components for the Aetheris ecosystem, built with Chakra UI. Includes components for data visualization, forms, and displaying complex financial and operational data.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --sourcemap --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --sourcemap --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "framer-motion": "^11.2.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@hookform/resolvers": "^3.6.0",
    "ag-grid-community": "^31.3.2",
    "ag-grid-react": "^31.3.2",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "lodash-es": "^4.17.21",
    "react-hook-form": "^7.51.5",
    "react-icons": "^5.2.1",
    "react-number-format": "^5.3.4",
    "recharts": "^2.12.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.5.0",
    "@storybook/addon-essentials": "^8.1.10",
    "@storybook/addon-interactions": "^8.1.10",
    "@storybook/addon-links": "^8.1.10",
    "@storybook/addon-onboarding": "^8.1.10",
    "@storybook/blocks": "^8.1.10",
    "@storybook/react": "^8.1.10",
    "@storybook/react-vite": "^8.1.10",
    "@storybook/test": "^8.1.10",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/d3": "^7.4.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^0.8.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.2",
    "storybook": "^8.1.10",
    "tsup": "^8.1.0",
    "typescript": "^5.2.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "author": "Aetheris Systems, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aetheris-systems/aetheris-ecosystem.git",
    "directory": "packages/ui-components"
  },
  "bugs": {
    "url": "https://github.com/aetheris-systems/aetheris-ecosystem/issues"
  },
  "homepage": "https://github.com/aetheris-systems/aetheris-ecosystem/tree/main/packages/ui-components#readme",
  "keywords": [
    "aetheris",
    "react",
    "typescript",
    "chakra-ui",
    "components",
    "ui-kit",
    "design-system",
    "data-visualization",
    "ai",
    "fintech"
  ],
  "publishConfig": {
    "access": "public"
  }
}