{
  "name": "@ocip/ontology",
  "version": "0.1.0",
  "description": "Shared ontology, data models, and type definitions for the Open Core Intelligence Platform (OCIP) ecosystem.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
