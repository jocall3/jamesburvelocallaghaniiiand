{
  "packageName": "quants_sdk",
  "projectName": "quants-sdk",
  "packageVersion": "1.0.0",
  "library": "urllib3",
  "generateSourceCodeOnly": false,
  "hideGenerationTimestamp": true,
  "allowUnicodeIdentifiers": false,
  "dateLibrary": "datetime",
  "enumPropertyNaming": "snake_case",
  "modelPropertyNaming": "snake_case",
  "prependFormOrBodyParameters": false,
  "sortModelPropertiesByRequiredFlag": true,
  "sortParamsByRequiredFlag": true,
  "useUUID": true,
  "verbose": false,
  "pythonVersion": "3.9",
  "asyncio": false,
  "disallowAdditionalPropertiesIfNotPresent": false,
  "generateAliasAsModel": false,
  "generateInterfaces": false,
  "legacyDiscriminatorBehavior": true,
  "nullSafeAndStrictExtra": false,
  "openapiNormalizer": {
    "REMOVE_OAS_EXTENSIONS": false,
    "SET_TAGS_FOR_ALL_OPERATIONS": false,
    "SORT_ENUM_VALUES": false,
    "NORMALIZE_SUCCESS_STATUS_CODE": false
  },
  "outputFile": "quants_sdk.zip",
  "outputFolder": "generated-sources/python",
  "skipFormModel": false,
  "skipValidateSpec": false,
  "strictSpecBehavior": false,
  "useOneOfDiscriminatorLookup": false,
  "usePythonicEnumName": true,
  "useReferencedSchemaAsModel": true,
  "useRequestContext": false,
  "useTypedDicts": true,
  "withV2Endpoint": false
}