{
  "$schema": "https://raw.githubusercontent.com/OpenAPITools/openapi-generator/master/modules/openapi-generator/src/main/resources/schema/config.json",
  "npmName": "@my-project/api-client",
  "npmVersion": "1.0.0",
  "npmRepository": "https://github.com/my-org/my-project-api-client",
  "snapshot": false,
  "supportsES6": true,
  "typescriptThreePlus": true,
  "withInterfaces": true,
  "useSingleRequestParameter": true,
  "modelPropertyNaming": "camelCase",
  "paramNaming": "camelCase",
  "enumPropertyNaming": "PascalCase",
  "stringEnums": true,
  "legacyDiscriminatorBehavior": false,
  "disallowAdditionalPropertiesIfNotPresent": false,
  "apiPackage": "api",
  "modelPackage": "model",
  "configurationPackage": "configuration",
  "prependFormOrBodyParameters": true,
  "sortParamsByRequiredFlag": true,
  "sortModelPropertiesByRequiredFlag": true,
  "licenseName": "UNLICENSED",
  "licenseUrl": "",
  "gitHost": "github.com",
  "gitUserId": "my-org",
  "gitRepoId": "my-project-api-client"
}