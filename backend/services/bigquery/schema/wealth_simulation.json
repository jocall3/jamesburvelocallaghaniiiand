[
  {
    "name": "simulation_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "Unique UUID for the specific simulation execution context."
  },
  {
    "name": "entity_id",
    "type": "STRING",
    "mode": "REQUIRED",
    "description": "The user, organization, or portfolio ID being simulated."
  },
  {
    "name": "event_timestamp",
    "type": "TIMESTAMP",
    "mode": "REQUIRED",
    "description": "The virtual or historical time point for this data snapshot."
  },
  {
    "name": "ingestion_timestamp",
    "type": "TIMESTAMP",
    "mode": "NULLABLE",
    "description": "Server time when the record was written to BigQuery."
  },
  {
    "name": "simulation_config",
    "type": "RECORD",
    "mode": "NULLABLE",
    "description": "Configuration parameters defining the simulation run.",
    "fields": [
      {
        "name": "scenario_name",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "model_version",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "risk_tolerance_score",
        "type": "FLOAT",
        "mode": "NULLABLE"
      },
      {
        "name": "time_horizon_years",
        "type": "INTEGER",
        "mode": "NULLABLE"
      }
    ]
  },
  {
    "name": "financial_position",
    "type": "RECORD",
    "mode": "REQUIRED",
    "description": "Aggregated financial metrics for the entity at this timestamp.",
    "fields": [
      {
        "name": "net_worth",
        "type": "NUMERIC",
        "mode": "REQUIRED"
      },
      {
        "name": "liquid_assets",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "illiquid_assets",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "total_liabilities",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "tax_liability_estimate",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "currency_code",
        "type": "STRING",
        "mode": "REQUIRED"
      }
    ]
  },
  {
    "name": "portfolio_breakdown",
    "type": "RECORD",
    "mode": "REPEATED",
    "description": "Detailed breakdown of asset holdings.",
    "fields": [
      {
        "name": "asset_id",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "asset_class",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "ticker_symbol",
        "type": "STRING",
        "mode": "NULLABLE"
      },
      {
        "name": "quantity",
        "type": "FLOAT",
        "mode": "NULLABLE"
      },
      {
        "name": "market_price",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "total_value",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "cost_basis",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      },
      {
        "name": "unrealized_pnl",
        "type": "NUMERIC",
        "mode": "NULLABLE"
      }
    ]
  },
  {
    "name": "market_environment",
    "type": "RECORD",
    "mode": "NULLABLE",
    "description": "Environmental variables and macro-economic factors applied.",
    "fields": [
      {
        "name": "inflation_rate",
        "type": "FLOAT",
        "mode": "NULLABLE"
      },
      {
        "name": "risk_free_rate",
        "type": "FLOAT",
        "mode": "NULLABLE"
      },
      {
        "name": "gdp_growth_rate",
        "type": "FLOAT",
        "mode": "NULLABLE"
      },
      {
        "name": "market_volatility_vix",
        "type": "FLOAT",
        "mode": "NULLABLE"
      }
    ]
  },
  {
    "name": "projection_deltas",
    "type": "RECORD",
    "mode": "REPEATED",
    "description": "Projected changes based on simulation logic (Monte Carlo steps).",
    "fields": [
      {
        "name": "metric_name",
        "type": "STRING",
        "mode": "REQUIRED"
      },
      {
        "name": "delta_value",
        "type": "NUMERIC",
        "mode": "REQUIRED"
      },
      {
        "name": "delta_percentage",
        "type": "FLOAT",
        "mode": "NULLABLE"
      }
    ]
  },
  {
    "name": "raw_simulation_payload",
    "type": "JSON",
    "mode": "NULLABLE",
    "description": "Unstructured JSON blob for storing raw model outputs or debugging data."
  }
]